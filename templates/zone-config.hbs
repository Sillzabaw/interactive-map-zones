<div class="imz-zone-config">

  <div class="form-group">
    <label>{{localize "IMZ.Config.ZoneName"}}</label>
    <input
      type="text"
      name="name"
      value="{{zone.name}}"
      placeholder="{{localize 'IMZ.Config.ZoneNamePlaceholder'}}"
    >
  </div>

  <div class="form-group">
    <label>{{localize "IMZ.Config.LinkedJournal"}}</label>

    <select name="journalUuid">
      <option value="">{{localize "IMZ.Config.None"}}</option>

      {{#each journals}}
        <option
          value="{{uuid}}"
          {{#if selected}}selected{{/if}}
        >
          {{name}}
        </option>
      {{/each}}
    </select>
  </div>

  <hr>

  <h3>{{localize "IMZ.Config.ZoneSection"}}</h3>

  <div class="form-group">
    <label>{{localize "IMZ.Config.FillColor"}}</label>

    <input
      type="color"
      name="fillColor"
      value="{{zone.fillColor}}"
    >
  </div>

  <div class="form-group">
    <label>{{localize "IMZ.Config.Opacity"}}</label>

    <div style="display: flex; align-items: center; gap: 10px;">

      <input
        type="range"
        name="fillAlpha"
        min="0"
        max="1"
        step="0.05"
        value="{{zone.fillAlpha}}"
        class="imz-alpha-slider"
      >

      <span class="imz-alpha-value">
        {{zone.fillAlphaPercent}} %
      </span>

    </div>
  </div>

  <div class="form-group">
    <label>{{localize "IMZ.Config.BorderColor"}}</label>

    <input
      type="color"
      name="borderColor"
      value="{{zone.borderColor}}"
    >
  </div>

  <div class="form-group">
    <label>{{localize "IMZ.Config.BorderWidth"}}</label>

    <input
      type="number"
      name="borderWidth"
      min="1"
      max="20"
      value="{{zone.borderWidth}}"
    >
  </div>

  <hr>

  <h3>{{localize "IMZ.Config.TextSection"}}</h3>

  <div class="form-group">
    <label>
      <input
        type="checkbox"
        name="showLabel"
        {{#if zone.showLabel}}checked{{/if}}
      >

      {{localize "IMZ.Config.ShowLabel"}}
    </label>
  </div>

  <div class="form-group">
    <label>{{localize "IMZ.Config.FontSize"}}</label>

    <input
      type="number"
      name="labelFontSize"
      min="8"
      max="100"
      value="{{zone.labelFontSize}}"
    >
  </div>

  <div class="form-group">
    <label>{{localize "IMZ.Config.TextColor"}}</label>

    <input
      type="color"
      name="labelColor"
      value="{{zone.labelColor}}"
    >
  </div>

  <div class="form-group">
    <label>{{localize "IMZ.Config.TextStrokeColor"}}</label>

    <input
      type="color"
      name="labelStrokeColor"
      value="{{zone.labelStrokeColor}}"
    >
  </div>

  <div class="form-group">
    <label>{{localize "IMZ.Config.TextStrokeWidth"}}</label>

    <input
      type="number"
      name="labelStrokeWidth"
      min="0"
      max="20"
      value="{{zone.labelStrokeWidth}}"
    >
  </div>

</div>